NODE_ENV=development
PORT=5009
MONGO_URI=mongodb://127.0.0.1:27017/astro_consult
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# Public site URL used in sitemap + reset-password emails
SITE_URL=http://localhost:5173

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional SMTP (if empty, reset links are printed to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AstroConnect <no-reply@astroconnect.example>"

# Secret used by YOUR astrologer-side tooling to reply (no astrologer panel exists)
ASTROLOGER_API_KEY=
# Testing only: astrologer auto-replies in chat so you can try the full flow alone
DEMO_AUTO_REPLY=false
